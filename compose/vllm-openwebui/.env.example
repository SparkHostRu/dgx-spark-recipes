# Copy to .env and edit.
HF_TOKEN=
# Any model from the vLLM playbook's tested matrix, e.g. openai/gpt-oss-120b, nvidia/Llama-3.3-70B-Instruct-NVFP4
MODEL=openai/gpt-oss-20b
# NGC tags: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm  (26.09-py3 was the newest stable tag on 2026-10-20)
VLLM_TAG=26.05.post1-py3
GPU_MEMORY_UTILIZATION=0.8
HF_CACHE=~/.cache/huggingface
